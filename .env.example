# ===== Credenciais KuCoin =====
# Obrigatórias apenas no MODO=live (no paper só se usam dados públicos)
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSPHRASE=

# ===== Modo de operação =====
# paper = preços reais da KuCoin + execução no simulador nativo (substitui o sandbox)
# live  = ordens reais na KuCoin
MODO=paper
# spot | futures   (futures usa ccxt.kucoinfutures e permite alavancagem/venda)
MARKET_TYPE=spot

# ===== Simulador paper (paper.py) =====
# Estado salvo em data/paper_<mercado>.json (apague o arquivo para reiniciar a simulação)
PAPER_CAPITAL=1000
PAPER_TAXA_PCT=0.1
PAPER_SLIPPAGE_PCT=0.05

# ===== Mercado =====
# Spot: BTC/USDT | Futures: BTC/USDT:USDT
SYMBOL=BTC/USDT
QUOTE_CURRENCY=USDT
TIMEFRAME=1h
CANDLE_LIMIT=300
LOOP_INTERVAL_SEC=60

# ===== Estratégia Fimathe =====
JANELA_PIVO=5
QTD_NIVEIS=3
# Posição do stop em relação à zona neutra rompida:
#   auto_adaptativo = seleção quantitativa automática (RVOL, KER e Força da Barra)
#   fora_caixinha   = extremo oposto da zona (1:1 simétrico ao alvo)
#   linha_50        = linha de 50% da zona (intermediário)
#   rompimento      = logo atrás do nível rompido (mais curto)
STOP_MODO=auto_adaptativo
FOLGA_STOP=0.1
AMPLITUDE_MIN_PCT=0.2
# Filtro de volatilidade estatística (calibrado via MATLAB / ATR)
ATR_FILTRO_ATIVO=false
ATR_PERIODO=14
FATOR_MIN_ATR=0.8
FATOR_MAX_ATR=3.5

# ===== Risco =====
RISCO_POR_TRADE_PCT=1.0
ALAVANCAGEM_MAX=3
MAX_POSICOES_ABERTAS=1
PERDA_DIARIA_MAX_PCT=3.0
RR_MINIMO=1.0
